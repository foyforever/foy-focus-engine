generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Submission {
  id                    Int      @id @default(autoincrement())
  email                 String
  answersJson           String
  primaryLane           String
  supportRevenueEngine  String
  distractionKillRule   String
  weeklyMilestonesJson  String
  createdAt             DateTime @default(now())
}
